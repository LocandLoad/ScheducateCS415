@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@model Scheducate.Models.UserGroup

@{
    ViewData["Title"] = "Group Details";
}

@{
    var currentUserId = UserManager.GetUserId(User);
    var isOwner = Model.OwnerId == currentUserId;
    var isMember = Model.Members.Any(m => m.UserId == currentUserId);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@Model.Name</h1>

        @if (Model.OwnerId == UserManager.GetUserId(User))
        {
            <a asp-action="Invite"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Create Invite
            </a>

            @if (!isMember)
            {
                <form asp-action="Join"
                      asp-route-id="@Model.Id"
                      method="post">
                    <button type="submit" class="btn btn-success">
                        Join Group
                    </button>
                </form>
            }
        }

        <a asp-action="Index" class="btn btn-secondary">
            Back to Groups
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="mb-0">Members</h3>
        </div>

        <div class="card-body">
            @if (Model.Members == null || !Model.Members.Any())
            {
                <p class="text-muted mb-0">
                    This group has no members yet.
                </p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var member in Model.Members)
                    {
                        <div class="list-group-item">
                            <div>
                                <strong>
                                    @(member.User?.UserName ?? "Unknown User")
                                </strong>

                                @if (member.UserId == Model.OwnerId)
                                {
                                    <span class="badge bg-primary ms-2">
                                        Owner
                                    </span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(member.User?.Email))
                            {
                                <small class="text-muted">
                                    @member.User.Email
                                </small>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

</div>
