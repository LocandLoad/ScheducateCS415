@model IEnumerable<Schedule>

@{
    ViewData["Title"] = "My Schedules";

    string[] days =
    {
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday"
};

}

<h1>@ViewData["Title"]</h1>

<a class="btn btn-primary mb-4" asp-controller="Schedules" asp-action="Create">
    Create Schedule
</a>

@if (!Model.Any())
{
    <p>You don't have any schedules yet.</p>
}
else
{
    @foreach (var schedule in Model)
    {
        <div class="schedule-card mb-5">

            <h2>@schedule.Name</h2>

            <div class="schedule-container">
                <div class="schedule-grid">

                    <!-- Header -->
                    <div class="time-header"></div>

                    @foreach (var day in days)
                    {
                        <div class="day-header">
                            @day
                        </div>
                    }

                    <!-- Time rows -->
                    @for (int timeIndex = 0; timeIndex < 48; timeIndex++)
                    {
                        int hour = timeIndex / 2;
                        int minute = (timeIndex % 2) * 30;

                        string period = hour < 12 ? "AM" : "PM";
                        int displayHour = hour % 12;

                        if (displayHour == 0)
                        {
                            displayHour = 12;
                        }

                        string time = $"{displayHour}:{minute:00} {period}";

                        <div class="time-label">
                            @time
                        </div>

                        @for (int dayIndex = 0; dayIndex < 7; dayIndex++)
                        {
                            int slotIndex = dayIndex * 48 + timeIndex;

                            int byteIndex = slotIndex / 8;
                            int bitIndex = slotIndex % 8;

                            bool selected =
                            (schedule.Availability[byteIndex] &
                            (1 << bitIndex)) != 0;

                            <div class="availability-cell @(selected ? "selected" : "")">
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
        <div class="mt-3">
            <a class="btn btn-danger"
               asp-controller="Schedules"
               asp-action="Delete"
               asp-route-id="@schedule.Id">
                Delete Schedule
            </a>
        </div>
    }

}

<link rel="stylesheet" href="~/css/Schedule.css" />