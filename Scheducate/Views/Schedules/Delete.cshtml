@model Schedule

@{
    ViewData["Title"] = "Delete Schedule";

    string[] days =
    {
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday"
};

}

<h1>Delete Schedule</h1>

<h2>@Model.Name</h2>

<p>Are you sure you want to delete this schedule?</p>

<div class="schedule-container">
    <div class="schedule-grid">

        <!-- Header -->
        <div class="time-header"></div>

        @foreach (var day in days)
        {
            <div class="day-header">
                @day
            </div>
        }

        <!-- Time rows -->
        @for (int timeIndex = 0; timeIndex < 48; timeIndex++)
        {
            int hour = timeIndex / 2;
            int minute = (timeIndex % 2) * 30;

            string period = hour < 12 ? "AM" : "PM";
            int displayHour = hour % 12;

            if (displayHour == 0)
            {
                displayHour = 12;
            }

            string time = $"{displayHour}:{minute:00} {period}";

            <div class="time-label">
                @time
            </div>

            @for (int dayIndex = 0; dayIndex < 7; dayIndex++)
            {
                int slotIndex = dayIndex * 48 + timeIndex;

                int byteIndex = slotIndex / 8;
                int bitIndex = slotIndex % 8;

                bool selected =
                (Model.Availability[byteIndex] &
                (1 << bitIndex)) != 0;

                <div class="availability-cell @(selected ? "selected" : "")">
                </div>
            }
        }
    </div>

</div>

<form asp-action="Delete" method="post" class="mt-3">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete Schedule
    </button>

    <a asp-action="Index" class="btn btn-secondary ms-2">
        Cancel
    </a>

</form>

<link rel="stylesheet" href="~/css/Schedule.css" />
