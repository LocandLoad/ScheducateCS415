@model Schedule

@{
    ViewData["Title"] = "Delete Schedule";

    string[] days =
    {
    "Sunday",
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday"
};

}

<h1>Delete Schedule</h1>

<h2>@Model.Name</h2>

<p>Are you sure you want to delete this schedule?</p>

<div class="schedule-container">
    <div class="schedule-grid">

        <!-- Header -->
        <div class="time-header"></div>

        @foreach (var day in days)
        {
            <div class="day-header">
                @day
            </div>
        }

        <!-- Time rows -->
        @for (int timeIndex = 0; timeIndex < 48; timeIndex++)
        {
            int hour = timeIndex / 2;
            int minute = (timeIndex % 2) * 30;

            string period = hour < 12 ? "AM" : "PM";
            int displayHour = hour % 12;

            if (displayHour == 0)
            {
                displayHour = 12;
            }

            string time = $"{displayHour}:{minute:00} {period}";

            <div class="time-label">
                @time
            </div>

            @for (int dayIndex = 0; dayIndex < 7; dayIndex++)
            {
                int slotIndex = dayIndex * 48 + timeIndex;

                int byteIndex = slotIndex / 8;
                int bitIndex = slotIndex % 8;

                bool selected =
                (Model.Availability[byteIndex] &
                (1 << bitIndex)) != 0;

                <div class="availability-cell @(selected ? "selected" : "")">
                </div>
            }
        }
    </div>

</div>

<form asp-action="Delete" method="post" class="mt-3">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete Schedule
    </button>

    <a asp-action="Index" class="btn btn-secondary ms-2">
        Cancel
    </a>

</form>

<style>
    .schedule-container {
        width: 100%;
        max-height: 700px;
        overflow: auto;
        border: 1px solid #dee2e6;
        user-select: none;
    }

    .schedule-grid {
        display: grid;
        grid-template-columns: 90px repeat(7, minmax(100px, 1fr));
        min-width: 800px;
    }

    .time-header {
        position: sticky;
        top: 0;
        left: 0;
        background: white;
        z-index: 3;
        border-bottom: 1px solid #dee2e6;
    }

    .day-header {
        position: sticky;
        top: 0;
        background: white;
        z-index: 2;
        text-align: center;
        font-weight: bold;
        padding: 10px 4px;
        border-bottom: 1px solid #dee2e6;
        border-left: 1px solid #dee2e6;
    }

    .time-label {
        height: 30px;
        padding-right: 8px;
        text-align: right;
        font-size: 12px;
        color: #6c757d;
        border-bottom: 1px solid #eee;
        background: white;
    }

    .availability-cell {
        height: 30px;
        border-left: 1px solid #dee2e6;
        border-bottom: 1px solid #eee;
        background-color: white;
    }

        .availability-cell.selected {
            background-color: #0d6efd;
        }
</style>
